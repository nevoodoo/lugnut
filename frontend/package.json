{
  "name": "lugnut-frontend",
  "private": true,
  "version": "0.1.0-dev0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src",
    "gen:api": "uv run python -m lugnut.openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && rm openapi.json",
    "test": "vitest run src",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.2",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
